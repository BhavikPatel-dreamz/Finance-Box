{
  "name": "financebox-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema": "node scripts/fetch-schema.mjs",
    "sections:inventory": "node scripts/section-inventory.mjs",
    "sections:check": "node scripts/check-sections.mjs",
    "typecheck": "tsc --noEmit",
    "new-section": "npx -y tsx scripts/new-section.ts",
    "remove-section": "npx -y tsx scripts/remove-section.ts",
    "sync-sections": "npx -y tsx scripts/sync-sections.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^17.0.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
